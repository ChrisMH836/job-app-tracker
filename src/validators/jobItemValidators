import z from 'zod';
//columnId, company, title, deadline, notes
export const createJobItemSchema = z.object({
  columnId: z.string(),
  company: z.string(),
  title: z.string(),
  deadline: z.date().optional(),
  notes: z.string().optional,
  status: z.enum([
    'SAVED',
    'APPLIED',
    'INTERVIEW',
    'OFFER',
    'REJECTED',
    'WITHDRAWN',
  ]),
});
